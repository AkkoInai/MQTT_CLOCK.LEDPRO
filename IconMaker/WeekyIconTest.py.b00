import sys, pygame

# --- 1. 定数・カラー定義 (RGB) ---
BG_COLOR = (32, 16, 48)        # 夜空のベースとなる深い紫
WHITE = (255, 255, 255)
GRAY = (80, 80, 80)

# 木・金・土・日のパレット仕様
L_GRN, GRN, D_GRN, BRN, SKIN = (170, 240, 0), (0, 200, 80), (0, 90, 40), (140, 90, 50), (200, 160, 110)
GLD, MID_YEL, BRZ = (255, 215, 0), (200, 160, 0), (128, 96, 0)
SUN_RED, SAT_BLU, EBICHA = (255, 32, 32), (32, 112, 255), (100, 30, 40)

# --- [完全修正] あなたのC言語ソースの16進数（ARGB）から、順序を正して正確に抽出したRGBパレット群 ---

# 月曜日パレット (ファイル3: Moon - あなたがPiskel上で並べた27色のARGBを100%正しいRGBに変換)
MON_PALETTE_RGB = [
    (7, 7, 7),       (15, 15, 15),    (25, 25, 25),    (12, 12, 12),    (7, 7, 7),       # 1, 2, 3, 4, 5
    (64, 182, 195),  (37, 48, 51),    (7, 7, 7),       (7, 7, 7),       (15, 15, 15),    # 6, 7, 8, 9, A
    (25, 25, 25),    (12, 12, 12),    (7, 7, 7),       (67, 190, 203),  (80, 228, 243),  # B, C, D, E, F
    (7, 7, 7),       (7, 7, 7),       (15, 15, 15),    (25, 25, 25),    (12, 12, 12),    # G, H, I, J, K
    (7, 7, 7),       (0, 0, 0),       (86, 241, 255),  (37, 48, 51),    (7, 7, 7),       # L, M, N, O, P
    (15, 15, 15),    (25, 25, 25),    (12, 12, 12),    (7, 7, 7),       (71, 203, 216),  # Q, R, S, T, U
    (83, 239, 254),  (49, 143, 154),  (7, 7, 7),       (15, 15, 15),    (25, 25, 25),    # V, W, X, Y, Z
    (12, 12, 12),    (7, 7, 7),       (81, 236, 253),  (5, 172, 227),   (25, 68, 75),    # a, b, c, d, e
    (7, 8, 9),       (15, 15, 15),    (25, 25, 25),    (23, 47, 52),    (73, 230, 251),  # f, g, h, i, j
    (71, 228, 251),  (67, 224, 249),  (7, 7, 7),       (9, 9, 9),       (50, 208, 243),  # k, l, m, n, o
    (59, 216, 246),  (59, 216, 246),  (5, 172, 227),   (59, 216, 246),  (9, 10, 10),     # p, q, r, s, t
    (9, 9, 9),       (22, 22, 22),    (29, 29, 29),    (37, 48, 51),    (32, 96, 114),   # u, v, w, x, y
    (25, 42, 47),    (22, 22, 22),    (22, 22, 22),    (22, 22, 22)                      # z, @, #, $
]

# 火曜日パレット (ファイル1: Fire - 16進数のARGB値を正しいRGBの並びに完全パッキング)
TUE_PALETTE_RGB = [
    (249, 230, 215),  # 1: 0xfff9e6d7
    (253, 187, 139),  # 2: 0xfffdbb8b
    (249, 129, 41),   # 3: 0xfff98129
    (255, 160, 90),   # 4: 0xffffa05a
    (255, 108, 0),    # 5: 0xffff6c00
    (255, 255, 255)   # 6: 0xffffffff
]

# 水曜日パレット (ファイル2: Water - 16進数のARGB値を正しいRGBの並びに完全パッキング)
WED_PALETTE_RGB = [
    (21, 21, 206),    # 1: 0xff1515ce
    (41, 41, 234),    # 2: 0xff2929ea
    (19, 106, 236),   # 3: 0xff136aec
    (8, 255, 250)     # 4: 0xff08fffa
]

# --- 2. 8x8pxをフルに使った文字列・数値展開 ---

# 月 (🌙: あなたがPiskelで綺麗に美化してくれた真の三日月。パレット文字と完全一致)
# 1文字ずつのマッピングを破綻させないため、全27色[1〜z, @, #, $]を36進数パース（0-9, a-z）の配列として完全に流し込み
STR_MON = "12341561" + "12341781" + "12341096" + "12341ABC" + "12341DEF" + "GHHIJKLL" + "MNNOPNQQ" + "RSTUVSSS"

# 火 (🔥: あなたのC言語データ、ファイル1から展開した大火力・薪の炎。1=f9e6d7, 2=fdbb8b, 3=f98129, 4=ffa05a, 5=ff6c00, 6=ffffff)
STR_TUE = "00000000" + "00000000" + "00001000" + "00023300" + "00142330" + "04223355" + "42363553" + "34123355"

# 水 (💧: あなたのC言語データ、ファイル2から展開したリアル水滴。1=1515ce, 2=2929ea, 3=136aec, 4=08fffa)
STR_WED = "00121000" + "10121100" + "10232121" + "12223211" + "21323320" + "11123322" + "12334331" + "12344331"

# 木 (🌳: 【永久凍結】絶対不動の最高傑作バランス、6行データ)
STR_THU = "00122300" + "01223330" + "02223330" + "00045000" + "00034000" + "00033000"

# 金 (🪙: 高級ゴールドカード仕様の大判コイン、6行データ)
STR_FRI = "00333300" + "03121220" + "03222220" + "00222220" + "00222220" + "00000000"

# 土 (🪐: 保留用土星、6行データ)
STR_SAT = "00033000" + "02222200" + "11222211" + "00222200" + "00033000" + "00000000"

# 日 (☀️: 自然な夜明け、6行データ)
STR_SUN = "00000000" + "00333300" + "03322330" + "03211230" + "21111112" + "41414141"

def parse_to_pixels(day_idx):
    data_str = [STR_MON, STR_TUE, STR_WED, STR_THU, STR_FRI, STR_SAT, STR_SUN][day_idx]
    num_rows = len(data_str) // 8
    pixels = []
    
    base36_str = "0123456789abcdefghijklmnopqrstuvwxyz"
    
    for r in range(num_rows):
        row = []
        for c in range(8):
            val = data_str[r * 8 + c].lower()
            if val in base36_str:
                row.append(base36_str.index(val))
            else:
                row.append(0)
        pixels.append(row)
    return pixels

ICONS = {
    0: {"palette": [BG_COLOR] + MON_PALETTE_RGB, "pixels": parse_to_pixels(0), "width": 8, "y_offset": 0},
    1: {"palette": [BG_COLOR] + TUE_PALETTE_RGB, "pixels": parse_to_pixels(1), "width": 8, "y_offset": 0}, 
    2: {"palette": [BG_COLOR] + WED_PALETTE_RGB, "pixels": parse_to_pixels(2), "width": 8, "y_offset": 0},
    3: {"palette": [BG_COLOR, L_GRN, GRN, D_GRN, BRN, SKIN], "pixels": parse_to_pixels(3), "width": 8, "y_offset": 1},
    4: {"palette": [BG_COLOR, WHITE, GLD, MID_YEL, BRZ], "pixels": parse_to_pixels(4), "width": 8, "y_offset": 1},
    5: {"palette": [BG_COLOR, WHITE, SAT_BLU, GRAY], "pixels": parse_to_pixels(5), "width": 8, "y_offset": 1},
    6: {"palette": [BG_COLOR, WHITE, SUN_RED, GRAY, EBICHA], "pixels": parse_to_pixels(6), "width": 8, "y_offset": 1}
}

def main():
    pygame.init()
    SCALE, V_WIDTH, V_HEIGHT = 4, 56, 8
    virtual_screen = pygame.Surface((V_WIDTH, V_HEIGHT))
    display_screen = pygame.display.set_mode((V_WIDTH * SCALE, V_HEIGHT * SCALE))
    pygame.display.set_caption("Icon Dot-Art Studio (Mon-Sun)")
    clock = pygame.time.Clock()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); sys.exit()
        virtual_screen.fill(BG_COLOR)
        
        current_x = 0
        for i in range(7):
            icon_data = ICONS[i]
            y_off = icon_data["y_offset"]
            for r, row in enumerate(icon_data["pixels"]):
                for c, p_val in enumerate(row):
                    if p_val > 0 and p_val < len(icon_data["palette"]):
                        virtual_screen.set_at((current_x + c, r + y_off), icon_data["palette"][p_val])
            current_x += icon_data["width"]

        pygame.transform.scale(virtual_screen, (V_WIDTH * SCALE, V_HEIGHT * SCALE), display_screen)
        pygame.display.flip()
        clock.tick(10)

if __name__ == "__main__": main()
