import sys, pygame

# --- 16ビットカラー(RGB565)制限をクリアしつつ、画面全体の色彩を豊かにするリッチパレット群 ---
BG_COLOR = (32, 16, 48)        # 0: 夜空のベースとなる深い紫
DEEP_RED = (128, 0, 32)        # 火の薪の燻り、および太陽の下辺を焦がす赤黒い大気の色
ICE_WHITE = (224, 240, 255)    # 水（💧）のひんやり感を演出する、青みのある白

WHITE = (255, 255, 255)
GRAY = (80, 80, 80)
L_YEL, YEL, ORG_SHD = (255, 255, 200), (255, 215, 0), (128, 64, 0)
YEL_FLM, RED = (255, 220, 0), (255, 32, 0)
SKY, AQUA, BLU_SHD = (128, 224, 255), (0, 160, 220), (0, 64, 160)
L_GRN, GRN, D_GRN, BRN, SKIN = (160, 240, 0), (0, 192, 64), (0, 80, 32), (128, 80, 32), (200, 160, 110)
GLD, MID_YEL, BRZ = (255, 215, 0), (200, 160, 0), (128, 96, 0)
SUN_RED, SAT_BLU = (255, 32, 32), (32, 112, 255)
EBICHA = (100, 30, 40)         # 太陽（☀️）を自然に馴染ませる、朝焼けの伝統的な「海老茶色」

# --- 金銀土日のリッチグラデーション用の新設パレット ---
GOLD_1, GOLD_2, GOLD_3, GOLD_4 = (255, 240, 150), (255, 215, 0), (200, 150, 0), (120, 85, 0)
SAT_1, SAT_2, SAT_3 = (150, 180, 255), (32, 112, 255), (10, 40, 120)
SUN_1, SUN_2, SUN_3 = (255, 200, 0), (255, 64, 0), (180, 16, 16)

# --- 月曜日（🌙）のためのGrok検出42階調カラーパレット完全復元 ---
MON_PALETTE = [
    BG_COLOR,
    (50, 30, 30),  (60, 35, 35),  (70, 40, 40),  (80, 45, 40),
    (90, 50, 40),  (100, 55, 40), (110, 60, 40), (120, 65, 40),
    (130, 70, 40), (140, 75, 40), (150, 80, 45), (160, 85, 45),
    (170, 95, 50), (180, 105, 55),(190, 115, 60),(200, 125, 65),
    (210, 135, 70),(220, 145, 75),(230, 155, 80),(235, 165, 85),
    (240, 175, 90),(245, 185, 95),(250, 190,100),(255, 195,110),
    (255, 200,120),(255, 205,130),(255, 210,140),(255, 215,150),
    (255, 220,160),(255, 225,170),(255, 230,180),(255, 232,190),
    (255, 235,195),(255, 238,200),(255, 240,205),(255, 242,210),
    (255, 245,215),(255, 248,220),(255, 250,225),(255, 252,230),
    WHITE
]

# 月 (🌙: 【完全復元】Grokが叩き出し、あなたが一瞬で理解したあの最も美しい42色パレットマップ)
LIST_MON = [
    0,0,0,0,0,0,4,0,
    0,0,0,0,0,0,3,4,
    0,0,0,0,0,0,2,1,
    0,0,0,0,0,3,1,1,
    4,5,4,3,2,3,2,3,
    1,1,1,1,1,2,1,4,
    0,3,1,2,2,1,4,0,
    0,0,4,2,3,4,0,0
]

# 火・水・木は完成度の高い最高傑作を完全死守（48文字＝6行）
STR_TUE = "00020000" + "00323000" + "03212300" + "03222300" + "32242230" + "03333300"
STR_WED = "00010000" + "00014000" + "00132400" + "00231400" + "01233340" + "00444400"
STR_THU = "00122300" + "01223330" + "02223330" + "00045000" + "00034000" + "00033000"

# 金・土・日は色数をケチらず、リッチな多色パレットでグラデーションを施した新設計（48文字＝6行）
# 金 (🪙: 1=WHITEのハイライト、2=GOLD_1, 3=GOLD_2, 4=GOLD_3, 5=GOLD_4の多色グラデーション黄金貨)
STR_FRI = "00555500" + "05123250" + "05233340" + "05334440" + "00444400" + "00000000"

# 土 (🪐: 1=WHITE[手前の輪], 2=SAT_1[球体明], 3=SAT_2, 4=SAT_3[球体暗], 5=GRAY[奥に回る影の輪] による超立体土星)
STR_SAT = "00000000" + "00023000" + "00234400" + "11113455" + "00044000" + "00000000"

# 日 (☀️: 1=WHITE[光源], 2=SUN_1[黄橙], 3=SUN_2[赤], 4=SUN_3[深赤], 5=EBICHA[地平線破線] が織りなす大炎上サンライズ)
STR_SUN = "00000000" + "00333300" + "03211230" + "32111123" + "21144112" + "51515151"

def parse_to_pixels(day_idx):
    pixels = []
    if day_idx == 0:
        for r in range(8):
            row = []
            for c in range(8):
                row.append(LIST_MON[r * 8 + c])
            pixels.append(row)
    else:
        data_str = [STR_TUE, STR_WED, STR_THU, STR_FRI, STR_SAT, STR_SUN][day_idx - 1]
        for r in range(6):
            row = []
            for c in range(8):
                row.append(int(data_str[r * 8 + c]))
            pixels.append(row)
    return pixels

ICONS = {
    0: {"palette": MON_PALETTE, "pixels": parse_to_pixels(0), "width": 8, "y_offset": 0},
    1: {"palette": [BG_COLOR, YEL_FLM, RED, DEEP_RED, WHITE], "pixels": parse_to_pixels(1), "width": 8, "y_offset": 1},
    2: {"palette": [BG_COLOR, ICE_WHITE, SKY, AQUA, BLU_SHD], "pixels": parse_to_pixels(2), "width": 8, "y_offset": 1},
    3: {"palette": [BG_COLOR, L_GRN, GRN, D_GRN, BRN, SKIN], "pixels": parse_to_pixels(3), "width": 8, "y_offset": 1},
    4: {"palette": [BG_COLOR, WHITE, GOLD_1, GOLD_2, GOLD_3, GOLD_4], "pixels": parse_to_pixels(4), "width": 8, "y_offset": 1},
    5: {"palette": [BG_COLOR, WHITE, SAT_1, SAT_2, SAT_3, GRAY], "pixels": parse_to_pixels(5), "width": 8, "y_offset": 1},
    6: {"palette": [BG_COLOR, WHITE, SUN_1, SUN_2, SUN_3, EBICHA], "pixels": parse_to_pixels(6), "width": 8, "y_offset": 1}
}

def main():
    pygame.init()
    SCALE, V_WIDTH, V_HEIGHT = 4, 56, 8
    virtual_screen = pygame.Surface((V_WIDTH, V_HEIGHT))
    display_screen = pygame.display.set_mode((V_WIDTH * SCALE, V_HEIGHT * SCALE))
    pygame.display.set_caption("Icon Dot-Art Studio (Mon-Sun)")
    clock = pygame.time.Clock()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); sys.exit()
        virtual_screen.fill(BG_COLOR)
        
        current_x = 0
        for i in range(7):
            icon_data = ICONS[i]
            y_off = icon_data["y_offset"]
            for r, row in enumerate(icon_data["pixels"]):
                for c, p_val in enumerate(row):
                    if p_val > 0:
                        virtual_screen.set_at((current_x + c, r + y_off), icon_data["palette"][p_val])
            current_x += icon_data["width"]

        pygame.transform.scale(virtual_screen, (V_WIDTH * SCALE, V_HEIGHT * SCALE), display_screen)
        pygame.display.flip()
        clock.tick(10)

if __name__ == "__main__": main()
