import sys, pygame

# --- RGB565（16ビットカラー）に厳格に準拠した職人パレット ---
BG_COLOR = (32, 16, 48)        # 0: 夜空のベースとなる深い紫
DEEP_RED = (128, 0, 32)        # 火の薪の燻り、および太陽の下辺を焦がす赤黒い大気の色
ICE_WHITE = (224, 240, 255)    # 水（💧）のひんやり感を演出する、青みのある白

WHITE = (255, 255, 255)
GRAY = (80, 80, 80)
L_YEL, YEL, ORG_SHD = (255, 255, 200), (255, 215, 0), (128, 64, 0)
YEL_FLM, RED = (255, 220, 0), (255, 32, 0)
SKY, AQUA, BLU_SHD = (128, 224, 255), (0, 160, 220), (0, 64, 160)
L_GRN, GRN, D_GRN, BRN, SKIN = (160, 240, 0), (0, 192, 64), (0, 80, 32), (128, 80, 32), (200, 160, 110)
GLD, MID_YEL, BRZ = (255, 215, 0), (200, 160, 0), (128, 96, 0)
SUN_RED, SAT_BLU = (255, 32, 32), (32, 112, 255)
EBICHA = (100, 30, 40)         # 太陽（☀️）を自然に馴染ませる、朝焼けの伝統的な「海老茶色」

# --- [新設] 月曜日（🌙）のためのGrok検出42階調カラーパレット（RGB565範囲内） ---
# 0番の夜空(BG_COLOR)から始まり、茶・橙の影を経て、まばゆい黄金（41番）まで滑らかに繋ぐ16bitグラデーション
MON_PALETTE = [
    BG_COLOR,                     # 0: 背景色
    (50, 30, 30),  (60, 35, 35),  (70, 40, 40),  (80, 45, 40),   # 1, 2, 3, 4
    (90, 50, 40),  (100, 55, 40), (110, 60, 40), (120, 65, 40),  # 5, 6, 7, 8
    (130, 70, 40), (140, 75, 40), (150, 80, 45), (160, 85, 45),  # 9, 10, 11, 12
    (170, 95, 50), (180, 105, 55),(190, 115, 60),(200, 125, 65),  # 13, 14, 15, 16
    (210, 135, 70),(220, 145, 75),(230, 155, 80),(235, 165, 85),  # 17, 18, 19, 20
    (240, 175, 90),(245, 185, 95),(250, 190,100),(255, 195,110),  # 21, 22, 23, 24
    (255, 200,120),(255, 205,130),(255, 210,140),(255, 215,150),  # 25, 26, 27, 28
    (255, 220,160),(255, 225,170),(255, 230,180),(255, 232,190),  # 29, 30, 31, 32
    (255, 235,195),(255, 238,200),(255, 240,205),(255, 242,210),  # 33, 34, 35, 36
    (255, 245,215),(255, 248,220),(255, 250,225),(255, 252,230),  # 37, 38, 39, 40
    WHITE                         # 41: 最大輝度のハイライト
]

# 8x8pxをフルに使った文字列展開（AIの自動要約バグを完全に封殺）

# 月 (🌙: お送りいただいたGrokの「書き出し」スキャンマップ（0〜41のパレット番号配列）を完璧にパースして流し込み！)
# 2桁の数値（13や29など）を正確に処理するため、パース関数側を「カンマ区切りの数値リスト」としてガチで固定します
LIST_MON = [
    0, 0, 0, 0, 0, 8, 27, 11,
    0, 0, 0, 0, 0, 6, 35, 32,
    0, 0, 0, 0, 0, 7, 34, 39,
    0, 0, 0, 0, 2, 17, 40, 41,
    4, 3, 1, 5, 15, 28, 38, 30,
    14, 26, 25, 18, 36, 37, 37, 23,
    13, 21, 29, 31, 33, 37, 24, 12,
    2, 9, 16, 22, 20, 19, 10, 0
]

# 火・水・木・金・土・日は1桁の文字列展開を完全維持（48文字＝6行）
STR_TUE = "00020000" + "00323000" + "03212300" + "03222300" + "32242230" + "03333300"
STR_WED = "00010000" + "00014000" + "00132400" + "00231400" + "01233340" + "00444400"
STR_THU = "00122300" + "01223330" + "02223330" + "00045000" + "00034000" + "00033000"
STR_FRI = "00333300" + "03121220" + "03222220" + "00222220" + "00222220" + "00000000"
STR_SAT = "00033000" + "02222200" + "11222211" + "00222200" + "00033000" + "00000000"
STR_SUN = "00000000" + "00333300" + "03322330" + "03211230" + "21111112" + "41414141"

def parse_to_pixels(day_idx):
    """月曜日（数値リスト）とそれ以外の曜日（文字列）を安全に判別して2次元配列化する"""
    pixels = []
    if day_idx == 0:
        # 月曜日の8行×8列のリスト処理
        for r in range(8):
            row = []
            for c in range(8):
                row.append(LIST_MON[r * 8 + c])
            pixels.append(row)
    else:
        # それ以外の曜日の6行×8列の文字列処理
        data_str = [STR_TUE, STR_WED, STR_THU, STR_FRI, STR_SAT, STR_SUN][day_idx - 1]
        for r in range(6):
            row = []
            for c in range(8):
                row.append(int(data_str[r * 8 + c]))
            pixels.append(row)
    return pixels

ICONS = {
    0: {"palette": MON_PALETTE, "pixels": parse_to_pixels(0), "width": 8, "y_offset": 0},
    1: {"palette": [BG_COLOR, YEL_FLM, RED, DEEP_RED, WHITE], "pixels": parse_to_pixels(1), "width": 8, "y_offset": 1},
    2: {"palette": [BG_COLOR, ICE_WHITE, SKY, AQUA, BLU_SHD], "pixels": parse_str_to_pixels if 'parse_str_to_pixels' in locals() else parse_to_pixels(2), "width": 8, "y_offset": 1},
    3: {"palette": [BG_COLOR, L_GRN, GRN, D_GRN, BRN, SKIN], "pixels": parse_to_pixels(3), "width": 8, "y_offset": 1},
    4: {"palette": [BG_COLOR, WHITE, GLD, MID_YEL, BRZ], "pixels": parse_to_pixels(4), "width": 8, "y_offset": 1},
    5: {"palette": [BG_COLOR, WHITE, SAT_BLU, GRAY], "pixels": parse_to_pixels(5), "width": 8, "y_offset": 1},
    6: {"palette": [BG_COLOR, WHITE, SUN_RED, GRAY, EBICHA], "pixels": parse_to_pixels(6), "width": 8, "y_offset": 1}
}

def main():
    pygame.init()
    SCALE, V_WIDTH, V_HEIGHT = 4, 56, 8
    virtual_screen = pygame.Surface((V_WIDTH, V_HEIGHT))
    display_screen = pygame.display.set_mode((V_WIDTH * SCALE, V_HEIGHT * SCALE))
    pygame.display.set_caption("Icon Dot-Art Studio (Mon-Sun)")
    clock = pygame.time.Clock()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT: pygame.quit(); sys.exit()
        virtual_screen.fill(BG_COLOR)
        
        current_x = 0
        for i in range(7):
            icon_data = ICONS[i]
            y_off = icon_data["y_offset"]
            for r, row in enumerate(icon_data["pixels"]):
                for c, p_val in enumerate(row):
                    if p_val > 0:
                        virtual_screen.set_at((current_x + c, r + y_off), icon_data["palette"][p_val])
            current_x += icon_data["width"]

        pygame.transform.scale(virtual_screen, (V_WIDTH * SCALE, V_HEIGHT * SCALE), display_screen)
        pygame.display.flip()
        clock.tick(10)

if __name__ == "__main__": main()
