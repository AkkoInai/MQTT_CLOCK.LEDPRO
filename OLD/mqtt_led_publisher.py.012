#!/usr/bin/env python3
"""
mqtt_led_publisher.py
----------------------
文字列(日本語含む)をラスタライズして、LEDマトリクス表示用のペイロードを
MQTTにpublishするツール。実機(ESP32-LEDPRO)側と同じペイロード形式を使う。

ペイロード形式(実機・PC共通):
  [flag: uint8][width: uint16 big-endian][height: uint16 big-endian][RGB565 raw data...]
  flag: 0=単発 / 1=分割の最初(新規) / 2=分割の途中(継ぎ足し) / 3=分割の最後(継ぎ足し+完成)
  RGB565データは 行優先(左上から右下へ)、1pxあたり2byte。
  --max-payload-bytesを超える場合は自動的に列(px)単位で分割し、実機からの
  要求(ledmatrix/request)に応じて1断片ずつ送信する(タイマーでの推測送信はしない)。

使い方:
  python3 mqtt_led_publisher.py "こんにちは、今日は晴れです" \
      --host localhost --topic ledmatrix/display

文字色(1文字単位で指定可能):
  デフォルトは白文字・黒背景固定(--fg/--bgは廃止)。文字列中にANSI 24bitカラーの
  エスケープシーケンスを埋め込むと、その位置から文字色が変わる。
    \x1b[38;2;R;G;Bm  ... ここから前景色をRGB(R,G,B)に変更
    \x1b[0m / \x1b[39m ... デフォルト色(白)に戻す
  例(bash): 祝日名だけ桜色にする
    python3 mqtt_led_publisher.py $'今日は祝日【\x1b[38;2;255;183;197m敬老の日\x1b[0m】'
  ANSI対応端末(手元のANSIカラービューア含む)ではエスケープをそのまま解釈して
  色付き表示されるので、送信前の見た目確認にも使える。

依存:
  pip install paho-mqtt pillow
"""
import argparse
import json
import re
import struct
import sys
import threading
import time

from PIL import Image, ImageDraw, ImageFont

try:
    import paho.mqtt.client as mqtt
except ImportError:
    mqtt = None


# 代表的な日本語フォントの候補パス(環境によって異なるので --font で上書き可能)
# IPAex/IPA/Takao/Noto の順で優先(LED表示ではゴシック系が見やすいためゴシックを優先)
DEFAULT_FONT_CANDIDATES = [
    "/usr/share/fonts/opentype/ipaexfont-gothic/ipaexg.ttf",
    "/usr/share/fonts/opentype/ipafont-gothic/ipag.ttf",
    "/usr/share/fonts/truetype/takao-gothic/TakaoPGothic.ttf",
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/opentype/noto/NotoSansMonoCJK-Regular.ttc",
]


def find_default_font():
    for path in DEFAULT_FONT_CANDIDATES:
        try:
            ImageFont.truetype(path, 16)
            return path
        except OSError:
            continue
    return None


def fit_font_size(font_path, target_ink_height):
    """
    指定した高さに実際の文字の黒インク部分がフィットするフォントサイズを逆算する。
    CJKフォントはフォントサイズ指定値と実際の見た目の高さがずれる(内部の余白の
    せいで指定値より小さく見える)ことが多いため、代表的な文字で実測して補正する。
    """
    test_size = max(4, target_ink_height)
    font = ImageFont.truetype(font_path, test_size)
    tmp = Image.new("L", (10, 10))
    d = ImageDraw.Draw(tmp)
    bbox = d.textbbox((0, 0), "国あ0", font=font)  # 漢字・かな・数字を代表させて計測
    ink_h = bbox[3] - bbox[1]
    if ink_h <= 0:
        return test_size
    scale = target_ink_height / ink_h
    return max(1, int(test_size * scale))


def draw_hinomaru(height=16):
    """日の丸(日章旗)のアイコンをPIL Imageとして描く。白地に赤丸、JIS規格に近い比率。"""
    width = int(height * 1.5)  # 国旗の縦横比(2:3)
    img = Image.new("RGB", (width, height), (255, 255, 255))
    draw = ImageDraw.Draw(img)
    circle_d = int(height * 0.6)  # 赤丸の直径は旗の縦の3/5(JIS規格相当)
    cx, cy = width / 2, height / 2
    r = circle_d / 2
    draw.ellipse([cx - r, cy - r, cx + r, cy + r], fill=(188, 0, 45))
    return img


# 文字色・背景色のデフォルト(--fg/--bgは廃止。文字単位の色指定はエスケープシーケンスで行う)
DEFAULT_FG = (255, 255, 255)
DEFAULT_BG = (0, 0, 0)

# 文字列中にこの絵文字が現れたら、対応する関数で描いたアイコンに差し替える。
# 今後、天気マークなどを増やす場合はここにエントリを追加するだけでよい。
ICON_MAP = {
    "🎌": draw_hinomaru,
}

# 文字色の指定: \x1b[38;2;R;G;Bm で以降の文字色を変更、\x1b[0m または \x1b[39m でデフォルト色に戻す。
# ANSI 24bitカラーのサブセットで、手元のANSI対応端末でもそのまま色確認ができる。
# 将来、グラデーションなど独自表現を追加したくなった場合は、このパターンの並びに
# 新しいエスケープコードを追加していく想定(今回はここまで)。
ANSI_COLOR_RE = re.compile(r'\x1b\[(?:38;2;(\d+);(\d+);(\d+)|0|39)m')


def parse_ansi_colors(text, default_fg):
    """
    文字列中のANSIエスケープ(色指定・リセット)を取り除きつつ、
    残った各文字に対応する色のリストを作る。
    戻り値: (clean_text, colors)  colors[i] が clean_text[i] の色(R,G,B)。
    """
    clean_chars = []
    colors = []
    color = default_fg
    i = 0
    while i < len(text):
        m = ANSI_COLOR_RE.match(text, i)
        if m:
            if m.group(1) is not None:
                color = (int(m.group(1)), int(m.group(2)), int(m.group(3)))
            else:
                color = default_fg  # \x1b[0m または \x1b[39m はデフォルト色に戻す
            i = m.end()
            continue
        clean_chars.append(text[i])
        colors.append(color)
        i += 1
    return "".join(clean_chars), colors


def split_into_segments(text, colors):
    """text(エスケープ除去後のclean text)をICON_MAPのマーカーとそれ以外のテキスト片に分割する。
    戻り値は [("text", str, [color,...]), ...] と [("icon", draw_fn), ...] が混在したリスト。
    colorsはtextと同じ長さで、各文字に対応する色のリスト。"""
    segments = []
    buf = ""
    buf_colors = []
    i = 0
    while i < len(text):
        matched = False
        for marker, draw_fn in ICON_MAP.items():
            if text.startswith(marker, i):
                if buf:
                    segments.append(("text", buf, buf_colors))
                    buf = ""
                    buf_colors = []
                segments.append(("icon", draw_fn))
                i += len(marker)
                matched = True
                break
        if not matched:
            buf += text[i]
            buf_colors.append(colors[i])
            i += 1
    if buf:
        segments.append(("text", buf, buf_colors))
    return segments


def rgb888_image_to_rgb565_bytes(img):
    """PIL の RGB Image を RGB565 big-endian の bytes に変換する"""
    raw = img.tobytes("raw", "RGB")  # R,G,B,R,G,B,...
    out = bytearray(len(raw) // 3 * 2)
    out_idx = 0
    for i in range(0, len(raw), 3):
        r, g, b = raw[i], raw[i + 1], raw[i + 2]
        v = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)
        out[out_idx] = (v >> 8) & 0xFF
        out[out_idx + 1] = v & 0xFF
        out_idx += 2
    return bytes(out)


def measure_text_tight(draw, text, font, char_spacing):
    """1文字ずつの幅(font.getlength)を積み上げて、字間隔調整後の全体幅を計算する"""
    total = 0.0
    for ch in text:
        total += draw.textlength(ch, font=font) + char_spacing
    if text:
        total -= char_spacing  # 最後の文字の後ろの間隔は含めない
    return max(0, total)


def draw_text_tight(draw, x, y, text, colors, font, char_spacing):
    """1文字ずつ、対応する色で描画し、文字間隔をchar_spacing(負の値で詰める)だけ調整する"""
    cx = x
    for ch, color in zip(text, colors):
        draw.text((cx, y), ch, font=font, fill=color)
        cx += draw.textlength(ch, font=font) + char_spacing
    return cx


def render_text_to_rgb565(text, panel_height=32, font_path=None, font_size=None,
                           fg_color=(255, 255, 255), bg_color=(0, 0, 0), margin=2,
                           icon_gap=3, char_spacing=-1):
    """
    文字列を高さ panel_height の1行ビットマップにラスタライズし、
    (width, height, rgb565_bytes) を返す。
    幅はテキスト量に応じて可変(=スクロール用の全体画像)。
    text 中に ICON_MAP に登録された絵文字(例: 🎌)が現れると、その位置に
    対応するアイコン画像を差し込んで描画する。
    char_spacing: 文字ごとの追加間隔(px)。負の値でフォント本来の字送りより詰める。
    """
    if font_path is None:
        font_path = find_default_font()
    if font_path is None:
        raise RuntimeError(
            "日本語フォントが見つかりません。--font でフォントファイルのパスを指定してください。"
        )
    if font_size is None:
        target_ink_height = panel_height - margin * 2
        font_size = fit_font_size(font_path, target_ink_height)

    font = ImageFont.truetype(font_path, font_size)
    height = panel_height
    icon_h = panel_height - margin * 2

    tmp_img = Image.new("RGB", (10, 10), bg_color)
    tmp_draw = ImageDraw.Draw(tmp_img)

    # エスケープシーケンス(\x1b[38;2;R;G;Bm / \x1b[0m / \x1b[39m)を取り除きつつ、
    # 残った各文字の色を確定させてから、アイコンマーカーでセグメント分割する
    clean_text, char_colors = parse_ansi_colors(text, fg_color)
    segments = split_into_segments(clean_text, char_colors)

    # 1周目: 各セグメントの幅を計算し、必要なら画像も先に作っておく
    prepared = []  # [("text", str, colors, w)] or [("icon", PIL.Image, w)]
    total_w = 0
    for seg in segments:
        if seg[0] == "text":
            _, value, value_colors = seg
            w = measure_text_tight(tmp_draw, value, font, char_spacing)
            prepared.append(("text", value, value_colors, w))
        else:  # icon
            _, draw_fn = seg
            icon_img = draw_fn(height=icon_h)
            ratio = icon_img.width / icon_img.height
            w = max(1, int(icon_h * ratio))
            icon_resized = icon_img.resize((w, icon_h), Image.NEAREST)
            prepared.append(("icon", icon_resized, w))
        total_w += w + icon_gap
    if prepared:
        total_w -= icon_gap  # 最後の要素の後ろの隙間は不要

    width = max(1, int(total_w) + margin * 2)
    img = Image.new("RGB", (width, height), bg_color)
    draw = ImageDraw.Draw(img)

    # 全体の縦位置合わせ用に、代表的な文字でインクの高さを測る
    ref_bbox = draw.textbbox((0, 0), "国Ag", font=font)
    text_h = ref_bbox[3] - ref_bbox[1]
    text_y = (height - text_h) // 2 - ref_bbox[1]

    # 2周目: 実際にキャンバスへ描画
    x = margin
    for item in prepared:
        if item[0] == "text":
            _, value, value_colors, w = item
            draw_text_tight(draw, x, text_y, value, value_colors, font, char_spacing)
        else:
            _, icon_resized, w = item
            icon_y = (height - icon_resized.height) // 2
            img.paste(icon_resized, (int(x), icon_y))
        x += w + icon_gap

    data = rgb888_image_to_rgb565_bytes(img)
    return width, height, data


def pack_chunk_payload(flag, width, height, rgb565_data):
    """flag: 0=単発 / 1=分割の最初 / 2=分割の途中 / 3=分割の最後"""
    header = struct.pack(">BHH", flag, width, height)
    return header + rgb565_data


def slice_rgb565_columns(data, width, height, x_start, x_count):
    """RGB565生データ(行優先, 2byte/px)から列範囲[x_start, x_start+x_count)を切り出す"""
    out = bytearray(x_count * height * 2)
    row_stride = width * 2
    out_stride = x_count * 2
    for y in range(height):
        src_off = y * row_stride + x_start * 2
        dst_off = y * out_stride
        out[dst_off:dst_off + out_stride] = data[src_off:src_off + out_stride]
    return bytes(out)


def main():
    parser = argparse.ArgumentParser(description="LEDマトリクス表示用テキストをMQTTにpublish")
    parser.add_argument("text", nargs="?", default=None,
                         help="表示したい文字列(日本語可)。設定だけ変更したい場合は省略可")
    parser.add_argument("--host", default="192.168.0.252", help="MQTTブローカーのホスト")
    parser.add_argument("--port", type=int, default=1883, help="MQTTブローカーのポート")
    parser.add_argument("--topic", default="ledmatrix/display", help="publish先トピック")
    parser.add_argument("--control-topic", default="ledmatrix/control", help="設定変更のpublish先トピック")
    parser.add_argument("--height", type=int, default=24,
                         help="パネルの高さ(px)。固定表示の時計帯(8px)を除いた"
                              "スクロール帯の高さに合わせ、既定値は24")
    parser.add_argument("--font", default=None, help="フォントファイルのパス")
    parser.add_argument("--font-size", type=int, default=None, help="フォントサイズ(px)")
    parser.add_argument("--char-spacing", type=int, default=-1,
                         help="文字ごとの追加間隔(px)。負の値でフォント本来より詰める(既定-1)")
    parser.add_argument("--dry-run", action="store_true",
                         help="MQTT送信せず、生成したペイロードのサイズだけ表示")
    parser.add_argument("--max-payload-bytes", type=int, default=60000,
                         help="この値を超える場合は自動的に分割送信する(単発メッセージの安全上限)")
    parser.add_argument("--chunk-width", type=int, default=600,
                         help="分割送信時、1断片あたりの幅(px)")
    parser.add_argument("--request-topic", default="ledmatrix/request",
                         help="実機が「もっとデータが欲しい」と要求してくるトピック")
    parser.add_argument("--request-timeout", type=float, default=60.0,
                         help="実機からの要求をこの秒数待っても来なければ中断する(正確な待ち時間の"
                              "予測ではなく、本当に応答が無い異常時だけを検知するための、"
                              "気長な安全網として設定する)")
    parser.add_argument("--max-total-width", type=int, default=900,
                         help="実機側のリング容量(MAX_FRAME_WIDTH)。超えると警告のみ表示し、"
                              "そのメッセージはrepeatが効かなくなる(送信自体は行う)")

    # ---- ここから設定変更用(ledmatrix/controlに自動publish、指定したものだけ反映) ----
    parser.add_argument("--scroll-speed", type=float, default=None,
                         help="スクロール速度(px/秒)を変更する。0で静止表示")
    parser.add_argument("--repeat", type=int, default=None,
                         help="繰り返し回数を変更する(0=無限ループ)")
    parser.add_argument("--brightness", type=int, default=None,
                         help="パネルの明るさ(0-255)を変更する")
    parser.add_argument("--weather-color", default=None,
                         help="天気アイコン(仮)の色 R,G,B を変更する")
    parser.add_argument("--is-holiday", choices=["true", "false"], default=None,
                         help="祝日フラグを変更する(桜色になる)")
    parser.add_argument("--holiday-name", default=None,
                         help="祝日名を送る(表示には使わないがシリアルログに残る)")
    parser.add_argument("--stop", action="store_true",
                         help="スクロール帯を強制的に空にする({\"cmd\":\"stop\"}を送る)")

    args = parser.parse_args()

    control = {}
    if args.scroll_speed is not None:
        control["scroll_speed"] = args.scroll_speed
    if args.repeat is not None:
        control["repeat"] = args.repeat
    if args.brightness is not None:
        control["brightness"] = args.brightness
    if args.weather_color is not None:
        control["weather_color"] = [int(v) for v in args.weather_color.split(",")]
    if args.is_holiday is not None:
        control["is_holiday"] = (args.is_holiday == "true")
    if args.holiday_name is not None:
        control["holiday_name"] = args.holiday_name
    if args.stop:
        control["cmd"] = "stop"

    if not control and args.text is None:
        print("エラー: 表示する文字列か、設定変更のオプションの少なくとも一方を指定してください",
              file=sys.stderr)
        sys.exit(1)

    # text指定があれば、この時点でレンダリングしてサイズ確認まで済ませる
    width = height = data = single_payload = None
    if args.text is not None:
        width, height, data = render_text_to_rgb565(
            args.text, panel_height=args.height, font_path=args.font,
            font_size=args.font_size, fg_color=DEFAULT_FG, bg_color=DEFAULT_BG,
            char_spacing=args.char_spacing,
        )
        single_payload = pack_chunk_payload(0, width, height, data)
        print(f"生成完了: width={width} height={height} payload_bytes={len(single_payload)}")

        if width > args.max_total_width:
            print(
                f"注記: 全体の幅が実機側のリング容量を超えます"
                f"(width={width}px > 容量{args.max_total_width}px)。"
                f"送信自体は行いますが、このメッセージはrepeat(繰り返し表示)ができません"
                f"(1回流れて終了します)。",
                file=sys.stderr,
            )

    if args.dry_run:
        if control:
            print(f"[dry-run] control送信予定: {json.dumps(control, ensure_ascii=False)}")
        return

    if mqtt is None:
        print("paho-mqtt がインストールされていません: pip install paho-mqtt", file=sys.stderr)
        sys.exit(1)

    client = mqtt.Client()
    client.connect(args.host, args.port, keepalive=10)
    client.loop_start()

    def publish_payload(topic, payload, qos=1):
        info = client.publish(topic, payload, qos=qos)
        info.wait_for_publish()

    # 1) 設定変更があれば先に送る(表示メッセージより前に反映させておく)
    if control:
        control_json = json.dumps(control, ensure_ascii=False)
        publish_payload(args.control_topic, control_json)
        print(f"control送信完了: topic={args.control_topic} body={control_json}")

    # 2) 表示メッセージがあれば送る(単発 or 自動分割)
    if args.text is not None:
        if len(single_payload) <= args.max_payload_bytes:
            # 単発で収まる(flag=0)
            publish_payload(args.topic, single_payload)
            print(f"publish完了(単発): topic={args.topic} host={args.host}:{args.port}")
        else:
            # 収まらないので、列(px)単位で自動分割する。
            # まずは空のプライミング(flag=1, width=0)を送り、実機からの即時応答で
            # 「今実際に使われているスクロール速度」を教えてもらってから、
            # それを根拠に正確な待ち時間を計算しながら実データ(flag=2/3)を送る。
            n_chunks = (width + args.chunk_width - 1) // args.chunk_width
            chunks = []
            for i in range(n_chunks):
                x_start = i * args.chunk_width
                x_count = min(args.chunk_width, width - x_start)
                chunk_data = slice_rgb565_columns(data, width, height, x_start, x_count)
                flag = 3 if i == n_chunks - 1 else 2
                chunks.append((flag, x_count, chunk_data))

            print(f"分割送信します: 全幅{width}px を {n_chunks}断片(1断片あたり最大{args.chunk_width}px)に分割 "
                  f"(プライミングで実速度を確認するネゴシエーション方式)")

            request_event = threading.Event()
            known_speed = {"value": None}

            def on_request(c, userdata, msg):
                try:
                    body = json.loads(msg.payload.decode("utf-8"))
                    if "scroll_speed" in body:
                        known_speed["value"] = float(body["scroll_speed"])
                except (ValueError, UnicodeDecodeError):
                    pass
                request_event.set()

            client.message_callback_add(args.request_topic, on_request)
            client.subscribe(args.request_topic)

            # 1) プライミング送信(空、flag=1) → 即座に返ってくる要求で実速度を知る
            priming_payload = pack_chunk_payload(1, 0, height, b"")
            publish_payload(args.topic, priming_payload)
            print("  プライミング送信完了(flag=1, width=0) - 実機からの応答を待機中...")

            got = request_event.wait(timeout=args.request_timeout)
            request_event.clear()
            if not got:
                print(f"警告: プライミングへの応答が{args.request_timeout:.1f}秒間ありませんでした。"
                      f"送信を中断します。", file=sys.stderr)
            else:
                if known_speed["value"] is not None:
                    print(f"  実機の現在のスクロール速度を確認: {known_speed['value']}px/秒")

                # 2) 実データを順に送る。次の断片を送った後は、今知っている速度を根拠に
                #    正確な待ち時間(表示に要する時間の1.5倍)を計算して要求を待つ。
                for i in range(n_chunks):
                    flag_i, w_i, data_i = chunks[i]
                    payload_i = pack_chunk_payload(flag_i, w_i, height, data_i)
                    publish_payload(args.topic, payload_i)
                    print(f"  断片{i + 1}/{n_chunks} 送信完了: flag={flag_i} width={w_i}px "
                          f"payload_bytes={len(payload_i)}")

                    if i == n_chunks - 1:
                        break  # 最後の断片を送ったら要求待ちは不要

                    speed = known_speed["value"]
                    if speed and speed > 0:
                        timeout = max(args.request_timeout, (w_i / speed) * 1.5)
                    else:
                        timeout = args.request_timeout

                    got = request_event.wait(timeout=timeout)
                    request_event.clear()
                    if not got:
                        print(
                            f"警告: {timeout:.1f}秒間、実機からの要求が届きませんでした。"
                            f"以降の断片({i + 2}〜{n_chunks})の送信を中断します。",
                            file=sys.stderr,
                        )
                        break
                    # 要求のたびに速度が更新されうる(途中で誰かが変更した場合も追従する)

            client.unsubscribe(args.request_topic)
            client.message_callback_remove(args.request_topic)
            print(f"publish完了(分割): topic={args.topic} host={args.host}:{args.port}")

    client.loop_stop()
    client.disconnect()


if __name__ == "__main__":
    main()
